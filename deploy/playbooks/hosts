[ngx]
ny-us ansible_host=ny-us ansible_user=yaitoo ansible_ssh_private_key_file=~/.ssh/id_rsa
#sh-ali ansible_host=sh-ali ansible_user=ecs-user ansible_ssh_private_key_file=~/.ssh/id_rsa
la-us ansible_host=la-us ansible_user=yaitoo ansible_ssh_private_key_file=~/.ssh/id_rsa


[ngx:vars]
ansible_python_interpreter=auto_silent

[tun]
xiajie ansible_host=xiajie ansible_user=dayi ansible_ssh_private_key_file=~/.ssh/id_rsa


[tun:vars]
ansible_python_interpreter=auto_silent

# ngx defaults
ngx_port_http=80
ngx_port_https=0
ngx_log_level=info
ngx_acme=false
ngx_acme_email=

# tun defaults
tun_server=0.0.0.0:9001
tun_token=
tun_name=default
tun_log_level=info