[Unit]
Description=Pangolin Gateway (ngx)
After=network.target

[Service]
Type=simple
User=pangolin
Group=pangolin
WorkingDirectory=/opt/pangolin
# Allow binding to privileged ports (80/443) while still running as
# the unprivileged `pangolin` user.  Without this, the binary panics
# with "Permission denied" on bind() because Linux treats <1024 as
# reserved for root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/opt/pangolin/ngx --config /opt/pangolin/ngx.yml
ExecReload=/bin/kill -SIGUSR2 $MAINPID
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target