# Pangolin ngx configuration
# Generated by Ansible deploy

port:
  http: {{ ngx_port_http | default(8080) }}
  https: {{ ngx_port_https | default(8443) }}

data:
  dir: /opt/pangolin/data

tls:
  acme: {{ ngx_acme | default(false) }}
  acme_email: {{ ngx_acme_email | default('') }}
  cert_file: /opt/pangolin/certs/tls.crt
  key_file: /opt/pangolin/certs/tls.key

log:
  level: {{ ngx_log_level | default('info') }}