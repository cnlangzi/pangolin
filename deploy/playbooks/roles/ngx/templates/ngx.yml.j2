# Pangolin ngx configuration
# Generated by Ansible deploy
#
# Schema MUST match `pangolin_core::config::Config` in
# crates/pangolin-core/src/config.rs. Every field in this file is
# optional (all have `#[serde(default)]`); delete sections you don't
# need to override.
#
# The top level of this file IS the proxy config — no `proxy:` wrapper.
# The `[tunnel]` sub-section is the WebSocket endpoint that tun
# clients connect into. Other features (admin UI, response cache,
# ACME certs, logging) each have their own sub-section.
#
# v2 ACME (PR #23) removed the global `cert.autorenew` toggle.
# Auto-issuance is now controlled **per-domain** via the
# `domains.auto_issue` column in the database, and the DNS provider
# used for DNS-01 challenges is set per-domain via `domains.dns_provider`
# (referencing a row in the `dns_providers` table, managed in the
# admin UI under "DNS Providers"). See docs/configuration.md and the
# v2 design doc for the full model.
#
#   addr.http            HTTP listen addr (default `0.0.0.0:80`)
#   addr.https           HTTPS listen addr (default `0.0.0.0:443`); ":0" disables
#   host                 virtual host used to resolve per-domain cert
#                        (default `None` → "default"). UNRELATED to [addr].
#   workers              pingora worker count (default = CPU count)
#   tunnel.addr          WS listener for tun clients (default `127.0.0.1:9001`)
#   tunnel.ws_path       WS endpoint path (default "/tunnel")
#   admin.addr           admin UI bind addr (default `127.0.0.1:9081`)
#   admin.username       admin UI basic-auth user
#   admin.password       admin UI basic-auth password
#   acme.cert_dir        where CertManager looks for cert blobs
#                        (autocert DirCache native layout: {host} or
#                        {host}+rsa; no `default` fallback in v2)
#   acme.acme_directory  ACME directory URL (LE staging for testing)
#   acme.key_type        "ecdsa" (default) or "rsa"
#   log.level            env_logger filter (trace|debug|info|warn|error)

# ── Proxy listen (top level) ────────────────────────────────────────────
addr:
  http: {{ ngx_addr_http | default('0.0.0.0:80') }}
  https: {{ ngx_addr_https | default('0.0.0.0:443') }}
{% if ngx_host is defined and ngx_host %}
host: {{ ngx_host }}
{% endif %}

# ── WebSocket endpoint for tun clients ──────────────────────────────────
tunnel:
  addr: {{ ngx_tunnel_addr | default('0.0.0.0:9001') }}
  ws_path: {{ ngx_tunnel_ws_path | default('/tunnel') }}

admin:
  # Default binds 0.0.0.0:9081 so a remote admin (e.g. via SSH
  # port forward) works without an explicit override. Set the
  # password directly in this file; restrict access via
  # ufw/iptables if exposing to a non-trusted network.
  addr: {{ ngx_admin_addr | default('0.0.0.0:9081') }}
  username: {{ ngx_admin_username | default('admin') }}
  password: {{ ngx_admin_password | default('admin') }}

acme:
  email: {{ ngx_acme_email | default('') }}
  cert_dir: {{ ngx_acme_cert_dir | default('/opt/pangolin/certs') }}
  acme_directory: {{ ngx_acme_directory | default('https://acme-v02.api.letsencrypt.org/directory') }}
  renew_threshold_days: {{ ngx_acme_renew_threshold_days | default(30) }}
  renew_check_interval_hours: {{ ngx_acme_renew_check_interval_hours | default(6) }}
  renew_max_retries: {{ ngx_acme_renew_max_retries | default(3) }}
  key_type: {{ ngx_acme_key_type | default('ecdsa') }}
  # v2: no `autorenew` field. Per-domain `auto_issue` is managed via
  # the admin UI / `domains` table. The legacy `ngx_acme` host var
  # is preserved for inventory compatibility but no longer mapped.

log:
  level: {{ ngx_log_level | default('info') }}
