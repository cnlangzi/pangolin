# Pangolin ngx configuration
# Generated by Ansible deploy
#
# Schema MUST match `pangolin_core::config::Config` in
# crates/pangolin-core/src/config.rs. Every field in this file is
# optional (all have `#[serde(default)]`); delete sections you don't
# need to override.
#
# The top level of this file IS the proxy config — no `proxy:` wrapper.
# The `[tunnel]` sub-section is the WebSocket endpoint that tun
# clients connect into. Other features (admin UI, response cache,
# ACME certs, logging) each have their own sub-section.
#
#   port                  HTTP listen port (default 80)
#   tls_port              HTTPS listen port; set 0 to disable TLS entirely
#   host                  virtual host used to resolve per-domain cert
#                         (default `None` → "default")
#   workers               pingora worker count (default = CPU count)
#   tunnel.port           WS listener for tun clients (default 9001)
#   tunnel.ws_path        WS endpoint path (default "/tunnel")
#   admin.*               admin UI bind addr + basic-auth creds
#   cert.cert_dir         where CertManager looks for fullchain.pem / privkey.pem
#   cert.autorenew        ACME auto-issue + renew (false = manual upload only)
#   log.level             env_logger filter (trace|debug|info|warn|error)

# ── Proxy listen (top level) ────────────────────────────────────────────
port: {{ ngx_port_http | default(80) }}
tls_port: {{ ngx_port_https | default(443) }}
{% if ngx_host is defined and ngx_host %}
host: {{ ngx_host }}
{% endif %}

# ── WebSocket endpoint for tun clients ──────────────────────────────────
tunnel:
  port: {{ ngx_tunnel_port | default(9001) }}
  ws_path: {{ ngx_tunnel_ws_path | default('/tunnel') }}

admin:
  # Bind on all IPv4 interfaces — deploys need remote management.
  # The Rust default (127.0.0.1:9081) is intentionally loopback for
  # local dev; we override it here.  Must be a standard socket addr
  # (`0.0.0.0:9081` or `127.0.0.1:9081`) — pingora rejects bare `:port`.
  # If the host has no firewall, restrict 9081 via ufw/iptables or
  # set ngx_admin_addr in hosts.
  addr: {{ ngx_admin_addr | default('0.0.0.0:9081') }}
  username: {{ ngx_admin_username | default('admin') }}
  password: {{ ngx_admin_password | default('admin') }}

cert:
  email: {{ ngx_acme_email | default('') }}
  cert_dir: /opt/pangolin/certs
  autorenew: {{ ngx_acme | default(false) | string | lower }}

log:
  level: {{ ngx_log_level | default('info') }}
