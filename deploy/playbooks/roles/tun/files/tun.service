[Unit]
Description=Pangolin Tunnel (tun)
After=network.target

[Service]
Type=simple
User=pangolin
Group=pangolin
WorkingDirectory=/opt/pangolin
# tun takes CLI args (--server/--token/--name), not a config file.
# Values come from the env file written by Ansible from hosts vars.
EnvironmentFile=/opt/pangolin/tun.env
ExecStart=/opt/pangolin/tun --server ${TUN_SERVER} --token ${TUN_TOKEN} --name ${TUN_NAME}
ExecReload=/bin/kill -SIGUSR2 $MAINPID
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
