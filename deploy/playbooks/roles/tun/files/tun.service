[Unit]
Description=Pangolin Tunnel (tun)
After=network.target

[Service]
Type=simple
User=pangolin
Group=pangolin
WorkingDirectory=/usr/local/pangolin
# tun reads its config from /usr/local/pangolin/tun.yml (a single YAML file
# managed by Ansible — see roles/tun/templates/tun.yml.j2). Override
# the path with `--config` if needed.
ExecStart=/usr/local/pangolin/pangolin-tun --config /usr/local/pangolin/tun.yml
ExecReload=/bin/kill -SIGUSR2 $MAINPID
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
