# Pangolin tun configuration
# Generated by Ansible deploy
#
# Schema MUST match `tun::config::TunConfig` in
# crates/tun/src/config.rs. The top level of this file IS the tun
# client config — its connection target, auth token, and node name.
# Only `[log]` is a sub-section.
#
# Required fields (validated at load — startup fails fast if invalid):
#   server     ngx address (e.g. "ngx.example.com:8080")
#   token      auth token (whitelisted in ngx's `tokens` table)
#   name       tun name; matches ^[a-z0-9_-]+$, 1..=32 chars,
#              non-purely-numeric
#
# `token` is sourced from the `tun_token` host var. For real deploys
# use Ansible Vault or an equivalent secret manager — never commit
# a real token to inventory.

server: {{ tun_server | default('ngx.example.com:8080') }}
token: "{{ tun_token | default('') }}"
name: {{ tun_name | default('default') }}

log:
  level: {{ tun_log_level | default('info') }}
