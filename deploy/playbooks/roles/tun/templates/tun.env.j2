# Pangolin tun environment file
# Sourced by /etc/systemd/system/pangolin-tun.service via `EnvironmentFile=`.
# Generated by Ansible deploy from the `tun_*` vars in hosts.

TUN_SERVER={{ tun_server | default('ngx.example.com:8080') }}
TUN_TOKEN={{ tun_token | default('') }}
TUN_NAME={{ tun_name | default('default') }}
