# Pangolin local + deploy configuration
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and edit. The Makefile auto-loads `.env` for
# every target (build, start-ngx, start-tun, play, install-*).
#
# Rules:
#   - `.env` is git-ignored; never commit secrets into it.
#   - Lines starting with `#` and blank lines are ignored.
#   - `export FOO=bar` and bare `FOO=bar` both work.
#   - Values may be quoted with " or ' (quotes are stripped).
#
# Naming convention: every var matches the **Rust binary's env-override
# schema** (`NGX_<SECTION>__<KEY>` / `TUN_<KEY>`), so the same `.env`
# works for both `make start-ngx` (binary reads it directly via
# figment) and `make play-ngx` (Ansible reads it via lookup('env')).
# The `__` double-underscore is the nested-key separator — single `_`
# can't express the YAML hierarchy (`admin.password` vs
# `acme.cert_dir`). See crates/pangolin-core/src/config.rs.
#
# Anything in this file is OVERRIDDEN by an already-set shell env var.
# Useful for one-off overrides:
#     make start-ngx NGX_ADMIN__PASSWORD=hunter2
# ─────────────────────────────────────────────────────────────────────────

# ── ngx (gateway / proxy) ────────────────────────────────────────────────
# Bind addresses (host:port)
NGX_ADDR__HTTP=0.0.0.0:80
NGX_ADDR__HTTPS=0.0.0.0:443

# Virtual host used to resolve the per-domain cert on disk.
# Leave empty to use the "default" cert.
NGX_HOST=

# WebSocket endpoint that tun clients connect to
NGX_TUNNEL__ADDR=0.0.0.0:9001
NGX_TUNNEL__WS_PATH=/tunnel

# Admin UI / API
NGX_ADMIN__ADDR=0.0.0.0:9081
NGX_ADMIN__USERNAME=admin
NGX_ADMIN__PASSWORD=admin

# ACME
NGX_ACME__EMAIL=
NGX_ACME__CERT_DIR=/usr/local/pangolin/certs
NGX_ACME__ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
NGX_ACME__RENEW_THRESHOLD_DAYS=30
NGX_ACME__RENEW_CHECK_INTERVAL_HOURS=6
NGX_ACME__RENEW_MAX_RETRIES=3
NGX_ACME__KEY_TYPE=ecdsa

# Logging
NGX_LOG__LEVEL=info

# ── tun (client) ─────────────────────────────────────────────────────────
# Where tun connects to. Must be reachable from the tun host.
TUN_SERVER=localhost:9001
TUN_TOKEN=dev
TUN_NAME=local

# Logging
TUN_LOG__LEVEL=info

# ─────────────────────────────────────────────────────────────────────────
# How `.env` reaches each consumer:
#
#   make start-ngx / make start-tun
#       Makefile does `set -a; . .env; set +a; ./bin/pangolin-ngx`.
#       Binary picks up NGX_* / TUN_* via figment's Env::prefixed(...)
#       layer (see ngx.yml / tun.yml header comments for the schema).
#
#   make play-ngx / make play-tun
#       Same `set -a; . .env; …` line, then ansible-playbook runs.
#       Each Ansible role's `vars:` block uses `lookup('env', 'NGX_*')`
#       to bridge the env vars into the lowercase `ngx_*` / `tun_*`
#       names referenced by the Jinja2 templates. The bridge is the
#       ONLY place that knows about the casing mismatch — templates
#       and `deploy/playbooks/hosts` group_vars are unchanged.
# ─────────────────────────────────────────────────────────────────────────