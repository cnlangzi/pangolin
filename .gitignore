# Build outputs
/bin/
/target
/build/output
**/*.rs.bk
Cargo.lock.bak

# Cargo registry / cache
/.cargo

# Node.js (for tailwindcss admin UI build)
/node_modules
/dist
/assets/static/*.css
/assets/static/*.js

# Standalone Tailwind + esbuild binaries, and generated admin-UI bundles.
# The bundle files are produced by `make build-ui` (or any release build,
# since `build-ngx: build-ui` chains them) from `tailwindcss.css` and
# `app.js` in the same directory. They MUST exist on disk at compile
# time — `rust-embed` snapshots `crates/admin/templates/public/` into
# the binary — but are regenerated deterministically from sources, so
# we don't track the artifacts.
/bin/
/crates/admin/templates/public/app.css
/crates/admin/templates/public/app.min.js

# Generated certs (test or runtime)
/certs
/certs-staging
*.pem
!testdata/**/*.pem

# Test artifacts
/coverage
/test-results
*.prof

# Local config (overrides)
/config.local.toml
*.local.yaml
*.local.yml

# Local secrets / per-developer environment overrides.
# Copy `.env.example` → `.env` and edit; the Makefile auto-loads it.
/.env
.env.local

# SQLite databases created at runtime by `pangolin-ngx` (e.g. from `make start-ngx`)
/pangolin.db
/pangolin.db-shm
/pangolin.db-wal

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
