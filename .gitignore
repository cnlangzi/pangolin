# Build outputs
/bin/
/target
/build/output
**/*.rs.bk
Cargo.lock.bak

# Cargo registry / cache
/.cargo

# Node.js (for tailwindcss admin UI build)
/node_modules
/dist
/assets/static/*.css
/assets/static/*.js

# Standalone Tailwind + esbuild binaries, and generated admin-UI bundles.
# `app.css` is produced by `make build-ui` (dev, unminified) or the Docker
# `builder` stage (minified) from `tailwindcss.css` in `assets/`. It MUST
# exist on disk at compile time — `rust-embed` snapshots `assets/` into
# the binary via `crates/admin/src/assets.rs` — but is regenerated
# deterministically from the tracked source, so we don't track the
# artifact. `app.js` is the tracked source; the Docker `builder` stage
# overwrites it in-place with the minified bundle, so the host copy is
# always the raw source.
#/bin/
/assets/app.css

# Intentionally absent: there is no `assets/vendor/` directory. JS deps
# (htmx today, anything else we add later) load from a public CDN pinned
# in the askama templates — see `layouts/base.html` and
# `pages/auth/login.html`. Don't vendor them; adding files here bloats the
# rust-embed binary and creates version-drift risk (templates already pin
# a different version than what would sit in `vendor/`).

# Generated certs (test or runtime)
/certs
/certs-staging
*.pem
!testdata/**/*.pem

# Test artifacts
/coverage
/test-results
*.prof

# Local config (overrides)
/config.local.toml
*.local.yaml
*.local.yml

# Local secrets / per-developer environment overrides.
# Copy `.env.example` → `.env` and edit; the Makefile auto-loads it.
/.env
.env.local

# SQLite databases created at runtime by `pangolin-ngx` (e.g. from `make start-ngx`)
/pangolin.db
/pangolin.db-shm
/pangolin.db-wal

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
.nightme/
