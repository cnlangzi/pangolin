[Unit]
Description=Pangolin Tunnel (tun)
After=network.target

[Service]
Type=simple
User=pangolin
Group=pangolin
WorkingDirectory=/var/lib/pangolin-tun
# The tun never binds a privileged port — it dials out to the
# gateway — so CAP_NET_BIND_SERVICE is inert here.  It is present
# anyway so that this unit and the gateway's unit keep exactly the
# same `[Service]` key set: the two units are the same unit with two
# different paths, and a test pins that they cannot drift apart.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/pangolin-tun --config /etc/pangolin/tun.yml
ExecReload=/bin/kill -SIGUSR2 $MAINPID
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
