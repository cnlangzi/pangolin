[Unit]
Description=Pangolin Gateway (ngx) - Local Dev
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/devin/code/pangolin
ExecStart=/home/devin/code/pangolin/bin/pangolin-ngx --conf /home/devin/code/pangolin/pangolin-ngx.yml
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target