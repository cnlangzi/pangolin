[Unit]
Description=Pangolin Tunnel (tun) - Local Dev
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/devin/code/pangolin
ExecStart=/home/devin/code/pangolin/bin/pangolin-tun --conf /home/devin/code/pangolin/pangolin-tun.yml
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target